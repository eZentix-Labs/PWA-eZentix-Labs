PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/stv-web
CLIENT_ORIGIN=http://localhost:5173

# --- Google Sheet (consultation bookings) ---
# Service account with Editor access to the sheet, shared from ezentixlabs@gmail.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings

# --- WhatsApp notification (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=918436299320

# --- n8n automation (recommended) ---
# When set, every new booking is POSTed here instead of using the direct
# Google Sheets / WhatsApp Cloud API integrations above. Build a workflow in
# n8n: Webhook trigger -> Google Sheets node (Append) -> WhatsApp node (Send).
N8N_WEBHOOK_URL=
# Optional: n8n verifies this HMAC-SHA256 signature (X-Webhook-Signature
# header) with a "Crypto" node before trusting the payload.
N8N_WEBHOOK_SECRET=
